#!/bin/sh
set -eu

PIDFILE=/run/platform-server.pid
BIN=/usr/local/bin/platform-server
CONFIG=/etc/platform/config.json
LOG=/var/log/platform/server.log

server_pids() {
  pgrep -f "$BIN -config" || true
}

status() {
  pids=$(server_pids)
  [ -n "$pids" ]
}

start() {
  if status; then
    # shellcheck disable=SC2086
    printf '%s\n' $pids | head -n 1 > "$PIDFILE"
    echo already-running
    return 0
  fi
  touch "$LOG"
  chown platform:platform "$LOG"
  start-stop-daemon --start --background --make-pidfile \
    --pidfile "$PIDFILE" --chuid platform:platform \
    --output "$LOG" \
    --exec "$BIN" -- -config "$CONFIG"
  echo started
}

stop() {
  if status; then
    # shellcheck disable=SC2086
    kill $pids || true
    i=0
    while status && [ "$i" -lt 25 ]; do
      i=$((i + 1))
      sleep 0.1
    done
    if status; then
      # shellcheck disable=SC2086
      kill -9 $pids || true
    fi
  fi
  rm -f "$PIDFILE"
}

case "${1:-start}" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  *)
    echo "usage: $0 start|stop|restart|status" >&2
    exit 2
    ;;
esac
